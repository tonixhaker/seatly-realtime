{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.seatly.dev/events/order.paid.json",
    "title": "order.paid",
    "type": "object",
    "allOf": [
        {
            "$ref": "envelope.json"
        }
    ],
    "properties": {
        "event_type": {
            "const": "order.paid"
        },
        "version": {
            "const": 1
        },
        "payload": {
            "type": "object",
            "properties": {
                "order_id": {
                    "type": "string",
                    "format": "uuid"
                },
                "event_id": {
                    "type": "integer",
                    "minimum": 1
                },
                "seat_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "buyer_id": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "order_id",
                "event_id",
                "seat_ids",
                "buyer_id"
            ],
            "additionalProperties": false
        }
    }
}
